{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "neekuro",
  "version": "2.2.0",
  "description": "Una biblioteca de imágenes con temática de anime para bots de Discord.",
  "main": "sources/main/index.js",
  "types": "sources/typings/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./sources/typings/index.d.ts",
        "default": "./sources/main/index.js"
      },
      "require": {
        "types": "./sources/typings/index.d.ts",
        "default": "./sources/main/index.js"
      }
    }
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "sources",
    "README.md",
    "CHANGELOG.md"
  ],
  "contributors": [
    "cacao0027 <kmzkuro@gmail.com>"
  ],
  "author": "cacao0027 <kmzkuro@gmail.com>",
  "keywords": [
    "anime",
    "acción",
    "gifs",
    "imagenes",
    "nsfw",
    "sfw",
    "discord",
    "action",
    "images"
  ],
  "license": "ISC",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check sources/main/index.js && node --test test/*.test.js && tsc -p test/tsconfig.json",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20.12.2"
  },
  "dependencies": {
    "canvas": "^3.1.0",
    "hex-color-regex": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CacaoNk0027/neekuro_package.git"
  },
  "bugs": {
    "url": "https://github.com/CacaoNk0027/neekuro_package/issues"
  },
  "homepage": "https://github.com/CacaoNk0027/neekuro_package#readme"
}
